FROM node:24.22.2-bookworm-slim

RUN apt-get update \
  && apt-get install --yes --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global npm@11.19.1 \
  && test "$(node --version)" = "v24.22.2" \
  && test "$(npm --version)" = "11.19.1"

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci
COPY .env.example .env.integration.example ./
COPY next.config.ts next-env.d.ts tsconfig.json postcss.config.mjs ./
COPY public ./public
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
COPY prisma.generate.config.ts ./prisma.generate.config.ts
COPY src ./src
COPY scripts ./scripts
COPY test ./test
RUN node_modules/.bin/prisma generate --config prisma.generate.config.ts
RUN env -i PATH="$PATH" HOME=/root NODE_ENV=production FLOW_ENV=test FLOW_EXECUTION=disabled NEXT_TELEMETRY_DISABLED=1 npm run build
ENV NODE_ENV=production FLOW_ENV=staging FLOW_EXECUTION=disabled
CMD ["node", "scripts/railway-db-operation.mjs"]
