FROM node:24.22.2-bookworm-slim

RUN apt-get update \
  && apt-get install --yes --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global npm@11.19.1 \
  && test "$(node --version)" = "v24.22.2" \
  && test "$(npm --version)" = "11.19.1"

COPY certs/railway-production-postgres-root.crt /usr/local/share/ca-certificates/flow-production-postgres-root.crt
RUN update-ca-certificates

WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY prisma ./prisma
COPY prisma.generate.config.ts prisma.config.ts ./
COPY src ./src
COPY scripts ./scripts
RUN node_modules/.bin/prisma generate --config prisma.generate.config.ts

ENV NODE_ENV=production FLOW_EXECUTION=disabled NODE_USE_SYSTEM_CA=1
CMD ["node", "scripts/railway-start.mjs"]
