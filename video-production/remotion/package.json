{
  "name": "flow-cinematic-explainer-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion 1080p/4K composition suite for the FLOW Cinematic Product Explainer Video",
  "scripts": {
    "studio": "remotion studio src/Root.tsx",
    "render:master": "remotion render src/Root.tsx FlowMasterExplainer ../renders/flow-master-4m30s.mp4 --codec=h264 --crf=18",
    "render:pitch90": "remotion render src/Root.tsx FlowPitch90 ../renders/flow-pitch-90s.mp4 --codec=h264 --crf=18",
    "render:promo30": "remotion render src/Root.tsx FlowPromo30 ../renders/flow-promo-30s.mp4 --codec=h264 --crf=18",
    "render:teaser15": "remotion render src/Root.tsx FlowTeaser15 ../renders/flow-teaser-15s.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.240",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.240"
  }
}
